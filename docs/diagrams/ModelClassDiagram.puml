@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam ArrowFontStyle plain
skinparam ArrowFontSize 13
skinparam nodesep 40
skinparam ranksep 75

package Model as ModelPackage {
    interface Model <<interface>>
    interface ReadOnlyAddressBook <<interface>>
    interface ReadOnlyUserPrefs <<interface>>

    class ModelManager
    class AddressBook
    class UserPrefs
    class UniquePersonList
    class Person
    class Name
    class Phone
    class Email
    class Address
    class Tag
    class Group
    class Role
    class Activity
    class Remark
}

package Commons as CommonsPackage {
    class GuiSettings
}

ModelManager .up.|> Model
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
Model ..> ReadOnlyAddressBook : accepts / returns
Model ..> ReadOnlyUserPrefs : returns

ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs -down-> "1" GuiSettings
AddressBook *-down-> "1" UniquePersonList
UniquePersonList -right-> "*" Person

Person -down-> "1" Name
Person -down-> "1" Phone
Person -down-> "1" Email
Person -down-> "1" Address
Person -down-> "*" Tag
Person -down-> "0..1" Group
Person -down-> "0..1" Role
Person -down-> "0..1" Activity
Person -down-> "1" Remark

ModelManager -[hidden]down-> Person

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> Address
Address -[hidden]right-> Tag
Tag -[hidden]right-> Group
Group -[hidden]right-> Role
Role -[hidden]right-> Activity
Activity -[hidden]right-> Remark

legend bottom
  Selected model structure; JavaFX collection internals are omitted.
  Every shown association uses a line; no associations are repeated as attributes.
  1 required; 0..1 optional; * zero or more. Unshown multiplicities are unspecified.
  The assignments are independent. A Remark always exists; empty text means no note.
endlegend

@enduml
